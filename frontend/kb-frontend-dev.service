[Unit]
Description=kb frontend dev server (Vite)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/kb/frontend
# npm must be resolvable via PATH -- set it explicitly here if not already on systemd's
# default PATH for user services (e.g. an nvm-installed node: Environment=PATH=%h/.nvm/versions/node/vX.Y.Z/bin:/usr/bin:/bin).
ExecStart=npm run dev
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
