#!/usr/bin/env -S uv run --project /home/violet/kb python3
"""Global kb CLI entry point. Usable from any directory (see ~/bin/kb symlink).

Usage: kb [--context NAME] [--as-of WHEN] <command> [subcommand ...] [args ...]
  --context NAME acts in that context for this command only (must already exist; see
  `kb context add`). Falls back to $KB_CONTEXT, then the persisted current context.
  --as-of WHEN runs this command as if the current time were WHEN, via time_machine --
  for previewing/debugging time-dependent output (e.g. `kb daily list` at a future
  hour) without waiting for real time to pass. Accepts 'HH:MM' (today), 'YYYY-MM-DD',
  or 'YYYY-MM-DD HH:MM', interpreted in local time. Read-only use only -- any writes
  made under --as-of (e.g. `kb daily complete`) are stamped with the simulated time.
  kb goal add "..." | show ID | complete ID | abandon ID | hold ID | reactivate ID
  kb idea add "..." | show ID | list | promote ID --to "..." | drop ID
  kb todo add "..." | show ID | update ID | complete ID | pending [--tag NAME] | tag ID TAG... | untag ID TAG...
  kb tag add NAME [--parent P] | show NAME | set-parent NAME [PARENT] | list
  kb daily add "..." | show ID | list | update ID | complete ID | activate ID | deactivate ID
  kb inbox add ... | pending | triage ID
  kb journal add ENTITY_TYPE ID NOTE | show ENTITY_TYPE ID
  kb notes get ID | add ... | update ... | search ... | reembed
  kb log add ... | recent
  kb context current | add NAME | switch NAME [--local] | clear [--local] | list | tree
  kb summary|sum|s [SECTION ...]
  kb wishlist add ... | update ID ...
  kb games pg entity npc|mob|mob-drop|item|player|character|relation|skill|hangout ...
  kb games pg quest show|add|complete ...
  kb pager FILE [--lines N] [--reset]
  kb anki decks | deck-add NAME | notetype-init | search QUERY | add DECK NOTETYPE FIELD... [--tags T] | delete ID... | run [-f FILE|-i]
"""

import argparse
import os
import subprocess
import sys
from datetime import datetime, timedelta
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))

_KB_ROOT = Path(__file__).resolve().parent
if (
    not os.environ.get("CI")
    and subprocess.run(["git", "config", "--get", "core.hooksPath"], cwd=_KB_ROOT, capture_output=True).returncode != 0
):
    subprocess.run(["scripts/dev/setup-hooks"], cwd=_KB_ROOT, check=False)

from context import resolve_context
from kb_cli import anki, context_cmd, daily, goal, idea, inbox, journal, log, notes, pager, summary, tag, todo, wishlist
from kb_cli import games
from models import SessionFactory


def _parse_as_of(raw: str) -> datetime:
    now = datetime.now()
    for fmt in ("%Y-%m-%d %H:%M", "%Y-%m-%d"):
        try:
            return datetime.strptime(raw, fmt)
        except ValueError:
            pass
    try:
        t = datetime.strptime(raw, "%H:%M").time()
    except ValueError:
        raise SystemExit(f"--as-of: could not parse {raw!r} (use HH:MM, 'YYYY-MM-DD', or 'YYYY-MM-DD HH:MM')")
    return now.replace(hour=t.hour, minute=t.minute, second=0, microsecond=0)


parser = argparse.ArgumentParser(prog="kb", description="Global kb CLI")
parser.add_argument("--context", metavar="NAME", help="Act in context NAME for this command only (must already exist)")
parser.add_argument("--as-of", metavar="WHEN", help="Run as if the current time were WHEN (local); see usage docstring")
subparsers = parser.add_subparsers(dest="command", required=True)

goal.add_subparser(subparsers)
idea.add_subparser(subparsers)
todo.add_subparser(subparsers)
tag.add_subparser(subparsers)
daily.add_subparser(subparsers)
inbox.add_subparser(subparsers)
journal.add_subparser(subparsers)
notes.add_subparser(subparsers)
log.add_subparser(subparsers)
context_cmd.add_subparser(subparsers)
summary.add_subparser(subparsers)
wishlist.add_subparser(subparsers)
pager.add_subparser(subparsers)
anki.add_subparser(subparsers)
games.add_subparser(subparsers)

args = parser.parse_args()
args.session = SessionFactory()
args.context_explicit = args.context is not None
try:
    args.context = resolve_context(args.session, args.context)
except ValueError as e:
    parser.error(str(e))

if args.as_of:
    import time_machine

    as_of_local = _parse_as_of(args.as_of).astimezone()
    with time_machine.travel(as_of_local, tick=False):
        args.func(args)
else:
    args.func(args)
