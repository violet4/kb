def _log_invocation(success: bool, error: str | None) -> None:
    """Record one row per top-level `kb` invocation (see CliInvocation in models.py) --
    a fresh, short-lived session, since a failed command may have left args.session's
    transaction in a state that shouldn't be reused for this. Logging itself must never
    be the reason a command fails, so any error here is swallowed, not raised."""
    try:
        from models import CliInvocation

        log_session = SessionFactory()
        log_session.add(CliInvocation(command=" ".join(sys.argv[1:]), success=success, error=error))
        log_session.commit()
        log_session.close()
    except Exception:
        pass


_original_error = argparse.ArgumentParser.error


def _error_and_log(self: argparse.ArgumentParser, message: str) -> None:
    """Overridden at the class level, not just on the top-level `parser` instance, since
    every subparser (`todo add`, `context tree`, ...) has its own bound .error() that a
    top-level-only override would never intercept -- a bad flag several levels deep
    (e.g. `todo add` with no title) needs the same audit-log row as a bad top-level
    subcommand name."""
    _log_invocation(success=False, error=message)
    print("(see `kb stats errors` for recent CLI error patterns)", file=sys.stderr)
    _original_error(self, message)  # always raises SystemExit(2)


argparse.ArgumentParser.error = _error_and_log  # type: ignore[method-assign]

args = parser.parse_args()
if args.command is None:
    print(f"This routing guide is printed by {Path(__file__).resolve()} (bare `kb`, no subcommand).\n")
    print(_BARE_INSTRUCTIONS, end="")
    sys.exit(0)
args.session = SessionFactory()
args.context_explicit = args.context is not None
args.context = resolve_context(args.session, args.context)

try:
    if args.as_of:
        import time_machine

        as_of_local = _parse_as_of(args.as_of).astimezone()
        with time_machine.travel(as_of_local, tick=False):
            args.func(args)
    else:
        args.func(args)
except SystemExit:
    raise
except Exception as e:
    _log_invocation(success=False, error=f"{type(e).__name__}: {e}")
    print("(see `kb stats errors` for recent CLI error patterns)", file=sys.stderr)
    raise
else:
    _log_invocation(success=True, error=None)
