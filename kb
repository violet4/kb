def _parse_as_of(raw: str) -> datetime:
    now = datetime.now()
    for fmt in ("%Y-%m-%d %H:%M", "%Y-%m-%d"):
        try:
            return datetime.strptime(raw, fmt)
        except ValueError:
            pass
    try:
        t = datetime.strptime(raw, "%H:%M").time()
    except ValueError:
        raise SystemExit(f"--as-of: could not parse {raw!r} (use HH:MM, 'YYYY-MM-DD', or 'YYYY-MM-DD HH:MM')")
    return now.replace(hour=t.hour, minute=t.minute, second=0, microsecond=0)


_HELP_EPILOG = """
Where a record belongs is the first argument of every `add` (CONTEXT, or #TAG), resolved by
context.py's resolve_placement(); read commands narrow with their own --context NAME, resolved
by resolve_context() and always echoed as "context: NAME" (or "context: none"). Neither creates
a context: an unknown name is an error listing close matches and the `kb context add` command
to run. Move a record later with `kb <noun> update ID --context NAME`.

--as-of runs the command as if the current time were WHEN, via time_machine, for
previewing/debugging time-dependent output without waiting for real time to pass. Read-only use
only -- any writes made under --as-of are stamped with the simulated time, not the real one.

Run bare `kb` (no arguments) for a short, task-oriented routing guide instead of this full
reference. See also: kb instructions root.
"""

