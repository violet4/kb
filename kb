def _parse_as_of(raw: str) -> datetime:
    now = datetime.now()
    for fmt in ("%Y-%m-%d %H:%M", "%Y-%m-%d"):
        try:
            return datetime.strptime(raw, fmt)
        except ValueError:
            pass
    try:
        t = datetime.strptime(raw, "%H:%M").time()
    except ValueError:
        raise SystemExit(f"--as-of: could not parse {raw!r} (use HH:MM, 'YYYY-MM-DD', or 'YYYY-MM-DD HH:MM')")
    return now.replace(hour=t.hour, minute=t.minute, second=0, microsecond=0)


_HELP_EPILOG = """
--context resolves once via resolve_context(): an explicit value is looked up, or created as
a new top-level Context with a short notice printed if it doesn't exist yet (a misspelled name
is meant to be caught by noticing that notice and fixed afterward with a context rename/move,
not by a hard error that forces retyping a whole command including any long --body text), and
applies for that single invocation only -- there is no ambient persisted default context to
fall back to (one used to exist -- CurrentContext, switched via `kb context switch` -- but a
context switched once for an unrelated task would silently narrow every later read, for both
sessions and days, without ever showing up as a strange result; it was removed for exactly
that reason). The resolved value (a Context) is threaded through as args.context to every
subcommand.

args.context is for READ-scoping only (`todo list`, `context tree`, `kb summary`, ...) --
every such command prints "context: NAME" (or "context: none") so the scope is never silently
invisible. With no --context, these commands show everything. `add` commands never use
args.context at all: with no explicit --context they pin the new row to `inbox` directly (see
creation_context() in context.py), so a fresh session can never create a record under an
unrelated leftover context. Relocate out of inbox with `kb <noun> update ID --context NAME`
once you know where it belongs.

--as-of runs the command as if the current time were WHEN, via time_machine, for
previewing/debugging time-dependent output without waiting for real time to pass. Read-only use
only -- any writes made under --as-of are stamped with the simulated time, not the real one.

Run bare `kb` (no arguments) for a short, task-oriented routing guide instead of this full
reference. See also: kb instructions root.
"""

parser = InstrumentedArgumentParser(
    prog="kb",
    description="Global kb CLI",
    epilog=_HELP_EPILOG,
    formatter_class=argparse.RawDescriptionHelpFormatter,
)
parser.add_argument(
