    metavar="NAME",
    help="Act in context NAME for this command only (created as new top-level if it doesn't exist)",
)
parser.add_argument("--as-of", metavar="WHEN", help="Run as if the current time were WHEN (local); see usage docstring")
subparsers = parser.add_subparsers(dest="command", required=False)

