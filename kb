def _record_invocation(payload: dict[str, Any]) -> None:
    """Write one CliInvocation row (see models/agents/usage.py) via a fresh, short-lived session, since a
    failed command may have left args.session's transaction in a state that shouldn't be
    reused for this. cli_instrumentation already guarantees this is never allowed to raise
    into the wrapped command, so no try/except is needed here. should_record/invocation_kwargs
    both live in kb_cli.cli_instrumentation_sink, independently testable against
    tests/conftest.py's in-memory db_session fixture."""
    from kb_cli.cli_instrumentation_sink import invocation_kwargs, should_record
    from models.agents.usage import CliInvocation

    if not should_record(payload):
        return

    log_session = SessionFactory()
    log_session.add(CliInvocation(**invocation_kwargs(payload)))
    log_session.commit()
    log_session.close()
    if not payload["success"]:
        print("(see `kb stats errors` for recent CLI error patterns)", file=sys.stderr)


def _run(args: argparse.Namespace) -> None:
    track_new_records(args.session)
    try:
        args.func(args)
    except ContextError as e:
        print(e, file=sys.stderr)
        sys.exit(1)
    print_similar(args.session)


attach_recording(parser, record=_record_invocation)
if len(sys.argv) > 1 and sys.argv[1].split("=")[0] == "--context":
    parser.error(
        "--context belongs to each command, after it: `kb todo list --context NAME` narrows a read; "
        "`kb todo add NAME TITLE` places a new record"
    )
args = parser.parse_args()
if args.command is None:
    print(f"This routing guide is printed by {Path(__file__).resolve()} (bare `kb`, no subcommand).\n")
    print(_BARE_INSTRUCTIONS, end="")
    sys.exit(0)
# A schema older than these models fails on the first query touching a newer column, with an
# error that names the column rather than the cause; refuse up front instead.
_pending = schema_version.pending_count()
if _pending:
    print(
        f"kb: the database schema is {_pending} migration(s) behind this code. Run:\n  {schema_version.UPGRADE_HINT}",
        file=sys.stderr,
    )
    sys.exit(1)
args.session = SessionFactory()

with instrumented_run(parser, args, record=_record_invocation):
    if args.as_of:
        import time_machine

        as_of_local = _parse_as_of(args.as_of).astimezone()
        with time_machine.travel(as_of_local, tick=False):
            _run(args)
    else:
        _run(args)
