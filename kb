    not os.environ.get("CI")
    and subprocess.run(["git", "config", "--get", "core.hooksPath"], cwd=_KB_ROOT, capture_output=True).returncode != 0
):
    subprocess.run(["scripts/dev/setup-hooks"], cwd=_KB_ROOT, check=False)

from context import resolve_context
from kb_cli import (
