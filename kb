#!/bin/sh
''''exec uv run --project "$(dirname "$(readlink -f "$0")")" python3 "$0" "$@" # '''
"""Global kb CLI entry point. Usable from any directory (see ~/bin/kb symlink).

Usage: kb [--context NAME] [--as-of WHEN] <command> [subcommand ...] [args ...]
  --context NAME acts in that context for this command only, creating it as a new top-level
  context (with a short notice printed) if it doesn't exist yet -- applies for READ-scoped
  commands only (`todo list`, `context tree`, `kb summary`, ...), which always print which
  context they resolved to (or "context: none" if unscoped). There is no persisted default
  context to fall back to; omitting --context shows everything. `add` commands ignore
  --context's ambient behavior entirely: with no explicit --context, a new row lands in the
  fixed `inbox` context instead.
  --as-of WHEN runs this command as if the current time were WHEN, via time_machine --
  for previewing/debugging time-dependent output (e.g. `kb daily list` at a future
  hour) without waiting for real time to pass. Accepts 'HH:MM' (today), 'YYYY-MM-DD',
  or 'YYYY-MM-DD HH:MM', interpreted in local time. Read-only use only -- any writes
  made under --as-of (e.g. `kb daily complete`) are stamped with the simulated time.
  kb goal add "..." | show ID | complete ID | abandon ID | hold ID | reactivate ID
  kb idea add "..." | show ID | list | promote ID --to "..." | drop ID
  kb todo add "..." | show ID | update ID | complete ID | pending [--tag NAME] | tag ID TAG... | untag ID TAG...
  kb tag add NAME [--parent P] | show NAME | set-parent NAME [PARENT] | list
  kb daily add "..." | show ID | list | update ID | complete ID | activate ID | deactivate ID
  kb inbox add ... | pending | triage ID
  kb instructions root [--set TITLE] | show TITLE | search QUERY | add TITLE BODY [--parent TITLE] [--trigger "..."] | set-parent TITLE [--parent TITLE] | edit TITLE [--title T] [--body B|--append TEXT|--replace OLD NEW] [--trigger "..."] | delete TITLE [--reparent-children] | tree [--bodies]
    # nodes are referenced by title everywhere; prefix with # for an id (only needed if a title is ambiguous). Use global --context to link a node into the Context tree.
  kb si show TITLE|#ID|root [--links] | add TITLE BODY [--parent TITLE] [--trigger "..."] | set-parent TITLE [--parent TITLE] | edit TITLE [--title T] [--body B|--append TEXT|--replace OLD NEW] [--trigger "..."] | delete TITLE [--reparent-children] | tree [--bodies]
    # system instructions, shipped with kb via git under instructions_system/ -- same for every user, distinct from `kb instructions` (this user's own DB tree). Full CRUD, same shape as `kb instructions` above, but every write prints a warning since it changes the shared git-tracked copy, not personal state.
  kb journal add ENTITY_TYPE ID NOTE | show ENTITY_TYPE ID
  kb notes show ID | add ... | update ... | search ... | reembed
  kb notifications mute | unmute | volume 0-100 | status | send TITLE [BODY] [--priority high]
  kb log add ... | recent
  kb context add NAME | list | tree
  kb summary|sum|s [SECTION ...]
  kb wishlist add ... | update ID ... | search QUERY
  kb vendor add NAME [--domain D] [--kind K] | list [--domain D] | search QUERY
  kb item add NAME [--game G] [--upc U] | list [--game G] | search QUERY
  kb purchase add VENDOR ITEM [--quantity N] [--unit-price P] [--notes ...] | list [--vendor V] [--item I] | search QUERY
  kb search QUERY   # search Goals, Todos, and Wishlist by text, plus Notes by semantic similarity
  kb text extract SOURCE [--cache] [--show N]   # clean text paragraphs from a URL/PDF/HTML/text file/stdin
  kb text semsearch rank QUERY [FILE] | compare A B   # rank/compare paragraphs by embedding
  kb games pg entity npc|mob|mob-drop|item|player|character|relation|skill|hangout ...
  kb games pg quest show|add|complete ...
  kb pager FILE [--lines N] [--reset]
  kb sessions   # list Claude Code CLI sessions across all projects
  kb stats errors [--days N] [--top N]   # CLI error patterns from CliInvocation audit log
  kb anki decks | deck-add NAME | notetype-init | search QUERY | add DECK NOTETYPE FIELD... [--tags T] | delete ID... | run [-f FILE|-i]
"""

import argparse
import os
import subprocess
import sys
from datetime import datetime, timedelta
from pathlib import Path
from typing import Any

try:
    from cli_instrumentation import InstrumentedArgumentParser, attach_recording, instrumented_run

    _HAVE_CLI_INSTRUMENTATION = True
except ImportError:
    # cli_instrumentation is an optional, not-yet-public dependency (CLI usage/error
    # analytics, `kb stats`) -- kb must work without it so a fresh clone never fails
    # `uv sync`/first-run just because this piece isn't installed. Falls back to a plain
    # argparse.ArgumentParser and a no-op instrumented_run; `kb stats` degrades to a clear
    # "not installed" message instead of crashing (see kb_cli/stats.py).
    from contextlib import contextmanager
    from typing import Iterator

    InstrumentedArgumentParser = argparse.ArgumentParser

    def attach_recording(parser: argparse.ArgumentParser, *, record: Any) -> None:
        pass

    @contextmanager
    def instrumented_run(parser: argparse.ArgumentParser, args: argparse.Namespace, *, record: Any) -> Iterator[None]:
        yield

    _HAVE_CLI_INSTRUMENTATION = False

sys.path.insert(0, str(Path(__file__).parent))

_KB_ROOT = Path(__file__).resolve().parent
if (
    not os.environ.get("CI")
    and subprocess.run(["git", "config", "--get", "core.hooksPath"], cwd=_KB_ROOT, capture_output=True).returncode != 0
