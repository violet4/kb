[Unit]
Description=KB personal knowledge base server
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/kb
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=PATH=%h/.local/bin:/usr/bin:/bin
ExecStart=uv run devserver.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
