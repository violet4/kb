#!/usr/bin/env -S uv run --project /home/violet/kb python3
"""Context operations. Usage: context {current,switch,list} ..."""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent))

from context import switch_current
from models import Context, CurrentContext, sess
from sqlalchemy import select


def cmd_current(args):
    context = CurrentContext.get()
    print(context.name if context else "(none)")


def cmd_switch(args):
    context = switch_current(args.name)
    sess.commit()
    print(f"Current context: {context.name!r}")


def cmd_list(args):
    contexts = sess.scalars(select(Context).order_by(Context.name)).all()
    if not contexts:
        print("No contexts yet.")
        return
    current = CurrentContext.get()
    for c in contexts:
        marker = " (current)" if current and current.id == c.id else ""
        print(f"#{c.id} {c.name}{marker}")


parser = argparse.ArgumentParser(description="Context operations")
sub = parser.add_subparsers(dest="cmd", required=True)

p_current = sub.add_parser("current", help="Show the active context")
p_current.set_defaults(func=cmd_current)

p_switch = sub.add_parser("switch", help="Change the active context")
p_switch.add_argument("name")
p_switch.set_defaults(func=cmd_switch)

p_list = sub.add_parser("list", help="List all known contexts")
p_list.set_defaults(func=cmd_list)

args = parser.parse_args()
args.func(args)
