#!/usr/bin/env -S uv run --project /home/violet/kb python3
"""Generic embedding-based ranking and comparison -- decoupled from any one content source.
Reads paragraphs (one per line) from stdin or a file, never fetches or parses anything itself.
Composes with `extract` (or any other line-per-paragraph producer) via a pipe:

    extract https://example.com/article | semsearch rank "query"
    extract report.pdf | semsearch rank "query" --top 3
    semsearch compare fileA.txt fileB.txt
    extract a.pdf | semsearch compare - <(extract b.pdf)

    semsearch rank QUERY [FILE]      # rank stdin/FILE's lines by relevance to QUERY
    semsearch compare A B            # cosine similarity between two texts/files/- (stdin)
"""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent.parent))

from embed import embed


def _cosine(a: list[float], b: list[float]) -> float:
    import numpy as np

    va, vb = np.array(a), np.array(b)
    return float(np.dot(va, vb) / (np.linalg.norm(va) * np.linalg.norm(vb)))


def _read_lines(source: str) -> list[str]:
    if source == "-":
        text = sys.stdin.read()
    else:
        text = Path(source).read_text()
    return [line for line in text.splitlines() if line.strip()]


def _read_text(source: str) -> str:
    if source == "-":
        return sys.stdin.read()
    return Path(source).read_text()


def cmd_rank(args: argparse.Namespace) -> None:
    lines = _read_lines(args.file)
    query_vec = embed(args.query)
    scored = [(1 - _cosine(query_vec, embed(line)), i, line) for i, line in enumerate(lines)]
    scored.sort(key=lambda x: x[0])
    for dist, i, line in scored[: args.top]:
        snippet = line[:150] + ("..." if len(line) > 150 else "")
        print(f"[{i}] (dist={dist:.3f}) {snippet}")


def cmd_compare(args: argparse.Namespace) -> None:
    text_a = _read_text(args.a)
    text_b = _read_text(args.b)
    similarity = _cosine(embed(text_a), embed(text_b))
    print(f"{similarity:.4f}")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_rank = sub.add_parser("rank", help="Rank stdin/FILE lines by relevance to a query")
    p_rank.add_argument("query")
    p_rank.add_argument("file", nargs="?", default="-", help="File to read paragraphs from (default: stdin)")
    p_rank.add_argument("--top", type=int, default=5)
    p_rank.set_defaults(func=cmd_rank)

    p_compare = sub.add_parser("compare", help="Cosine similarity between two texts")
    p_compare.add_argument("a", help="File path or - for stdin")
    p_compare.add_argument("b", help="File path or - for stdin")
    p_compare.set_defaults(func=cmd_compare)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
