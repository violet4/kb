#!/usr/bin/env -S uv run --project /home/violet/kb python3
"""Journal operations. Usage: journal show ENTITY_TYPE ENTITY_ID"""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent))

from models import Journal


def cmd_show(args):
    entries = Journal.for_entity(args.entity_type, args.entity_id)
    if not entries:
        print("No journal entries.")
        return
    for i, e in enumerate(entries):
        if i > 0:
            print()
        when = e.created_at.strftime("%Y-%m-%d %H:%M")
        if e.field:
            print(f"[{when}] {e.field}: {e.old_value!r} -> {e.new_value!r}")
            if e.note:
                print(f"  {e.note}")
        else:
            print(f"[{when}] {e.note}")


parser = argparse.ArgumentParser(description="Journal operations")
sub = parser.add_subparsers(dest="cmd", required=True)

p_show = sub.add_parser("show", help="Show journal history for an entity")
p_show.add_argument("entity_type")
p_show.add_argument("entity_id", type=int)
p_show.set_defaults(func=cmd_show)

args = parser.parse_args()
args.func(args)
