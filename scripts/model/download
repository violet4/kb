#!/usr/bin/env -S uv run --project /home/violet/kb python3
"""Explicitly download the embedding model from HuggingFace.

This is the only script that makes network calls to HF. Run it once on setup
or deliberately when upgrading models. After this, all embedding is local-only.
"""
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent.parent))

# Override offline mode for this explicit download
os.environ["HF_HUB_OFFLINE"] = "0"

from embed import _MODEL_NAME
from sentence_transformers import SentenceTransformer

print(f"Downloading model: {_MODEL_NAME}")
SentenceTransformer(_MODEL_NAME, local_files_only=False)
print(f"Done. Model cached locally — all future use is offline.")
