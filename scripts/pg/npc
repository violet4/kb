#!/usr/bin/env -S uv run --project /home/violet/kb python3
"""Project Gorgon NPC operations. Usage: npc {show,add} ..."""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent.parent))

from sqlalchemy import select
from models import PgNpc, sess


def cmd_show(args):
    for i, name in enumerate(args.names):
        if i > 0:
            print()
        npc = sess.scalars(select(PgNpc).filter_by(name=name)).one_or_none()
        if npc is None:
            print(f"name: {name}\nerror: not found", file=sys.stderr)
            continue
        print(f"id: {npc.id}")
        print(f"name: {npc.name}")
        if npc.race:
            print(f"race: {npc.race.name}")
        if npc.location:
            print(f"location: {npc.location}")
        if npc.notes:
            print(f"notes: {npc.notes}")


def cmd_add(args):
    existing = sess.scalars(select(PgNpc).filter_by(name=args.name)).one_or_none()
    if existing is not None:
        print(f"NPC {args.name!r} already exists (#{existing.id})", file=sys.stderr)
        sys.exit(1)
    npc = PgNpc(name=args.name, location=args.location, notes=args.notes or "")
    sess.add(npc)
    sess.commit()
    print(f"Added: #{npc.id} {npc.name!r}")


parser = argparse.ArgumentParser(description="Project Gorgon NPC operations")
sub = parser.add_subparsers(dest="cmd", required=True)

p_show = sub.add_parser("show", help="Show NPC details")
p_show.add_argument("names", nargs="+")
p_show.set_defaults(func=cmd_show)

p_add = sub.add_parser("add", help="Add an NPC")
p_add.add_argument("name")
p_add.add_argument("--location")
p_add.add_argument("--notes")
p_add.set_defaults(func=cmd_add)

args = parser.parse_args()
args.func(args)
