#!/usr/bin/env python3
"""Add a wishlist item. Usage: add TITLE [options]"""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent.parent))

from models import Wishlist, WishlistEffort, sess

parser = argparse.ArgumentParser(description="Add a wishlist item")
parser.add_argument("title")
parser.add_argument("--description")
parser.add_argument("--price-min", type=float)
parser.add_argument("--price-max", type=float)
parser.add_argument("--importance", type=int, default=50, help="0-100, default 50")
parser.add_argument("--urgency", type=int, default=50, help="0-100, default 50")
parser.add_argument("--clarity", type=int, default=50, help="0-100, default 50")
parser.add_argument("--effort", choices=[e.value for e in WishlistEffort], default="grab")
parser.add_argument("--priority", type=int, help="Explicit priority override (beats computed score)")
parser.add_argument("--notes")
args = parser.parse_args()

for name in ("importance", "urgency", "clarity"):
    value = getattr(args, name)
    if not 0 <= value <= 100:
        parser.error(f"--{name} must be 0-100, got {value}")

item = Wishlist(
    title=args.title,
    description=args.description,
    price_min=args.price_min,
    price_max=args.price_max,
    importance=args.importance,
    urgency=args.urgency,
    clarity=args.clarity,
    effort=WishlistEffort(args.effort),
    priority=args.priority,
    notes=args.notes,
)
sess.add(item)
sess.commit()
print(f"Added: {item} score={item.score}")
