#!/usr/bin/env -S uv run --project /home/violet/kb python3
"""Update fields on an existing wishlist item. Usage: update ID [options]"""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent.parent))

from models import Wishlist, WishlistEffort, WishlistStatus, sess

parser = argparse.ArgumentParser(description="Update a wishlist item")
parser.add_argument("id", type=int)
parser.add_argument("--title")
parser.add_argument("--description")
parser.add_argument("--price-min", type=float)
parser.add_argument("--price-max", type=float)
parser.add_argument("--importance", type=int, help="0-100")
parser.add_argument("--urgency", type=int, help="0-100")
parser.add_argument("--clarity", type=int, help="0-100")
parser.add_argument("--effort", choices=[e.value for e in WishlistEffort])
parser.add_argument("--priority", type=int, help="Explicit priority override (beats computed score)")
parser.add_argument("--status", choices=[s.value for s in WishlistStatus])
parser.add_argument("--notes")
args = parser.parse_args()

for name in ("importance", "urgency", "clarity"):
    value = getattr(args, name)
    if value is not None and not 0 <= value <= 100:
        parser.error(f"--{name} must be 0-100, got {value}")

item = sess.get(Wishlist, args.id)
if item is None:
    print(f"Wishlist #{args.id}: not found", file=sys.stderr)
    sys.exit(1)

if args.title is not None:
    item.title = args.title
if args.description is not None:
    item.description = args.description
if args.price_min is not None:
    item.price_min = args.price_min
if args.price_max is not None:
    item.price_max = args.price_max
if args.importance is not None:
    item.importance = args.importance
if args.urgency is not None:
    item.urgency = args.urgency
if args.clarity is not None:
    item.clarity = args.clarity
if args.effort is not None:
    item.effort = WishlistEffort(args.effort)
if args.priority is not None:
    item.priority = args.priority
if args.status is not None:
    item.status = WishlistStatus(args.status)
if args.notes is not None:
    item.notes = args.notes

sess.commit()
print(f"Updated: {item} score={item.score}")
